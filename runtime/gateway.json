{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Example API Gateway"
  },
  "paths": {
    "/api/users": {
      "get": {
        "summary": "Get all users",
        "description": "Retrieves a list of all users from the backend service",
        "operationId": "get-all-users",
        "x-opengate": {
          "type": "forward",
          "options": {
            "url": "http://localhost:3000"
          },
          "policies": ["auth-google"]
        },
        "responses": {
          "200": {
            "description": "A list of users"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token"
          }
        }
      },
      "post": {
        "summary": "Create a new user",
        "description": "Creates a new user in the system",
        "operationId": "create-user",
        "x-opengate": {
          "type": "forward",
          "options": {
            "url": "http://localhost:3000"
          },
          "policies": ["auth-google"]
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token"
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "summary": "Get user by ID",
        "description": "Retrieves a specific user by their ID",
        "operationId": "get-user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-opengate": {
          "type": "forward",
          "options": {
            "url": "http://localhost:3000"
          },
          "policies": ["auth-google"]
        },
        "responses": {
          "200": {
            "description": "User details"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "put": {
        "summary": "Update user",
        "description": "Updates an existing user",
        "operationId": "update-user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-opengate": {
          "type": "forward",
          "options": {
            "url": "http://localhost:3000"
          },
          "policies": ["auth-google"]
        },
        "responses": {
          "200": {
            "description": "User updated successfully"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "delete": {
        "summary": "Delete user",
        "description": "Deletes a user from the system",
        "operationId": "delete-user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-opengate": {
          "type": "forward",
          "options": {
            "url": "http://localhost:3000"
          },
          "policies": ["auth-google"]
        },
        "responses": {
          "204": {
            "description": "User deleted successfully"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/public/health": {
      "get": {
        "summary": "Public health check",
        "description": "Public health check endpoint without authentication",
        "operationId": "health-check",
        "x-opengate": {
          "type": "forward",
          "options": {
            "url": "http://localhost:3000"
          }
        },
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/redirect/permanent": {
      "get": {
        "summary": "Permanent redirect example",
        "description": "Permanently redirects to another location using 301 status code",
        "operationId": "redirect-permanent",
        "x-opengate": {
          "type": "redirect",
          "options": {
            "location": "https://example.com/new-location",
            "status_code": 301
          }
        },
        "responses": {
          "301": {
            "description": "Moved Permanently"
          }
        }
      }
    },
    "/redirect/temporary": {
      "get": {
        "summary": "Temporary redirect example",
        "description": "Temporarily redirects to another location using 302 status code",
        "operationId": "redirect-temporary",
        "x-opengate": {
          "type": "redirect",
          "options": {
            "location": "https://example.com/temp-location",
            "status_code": 302
          }
        },
        "responses": {
          "302": {
            "description": "Found (Temporary Redirect)"
          }
        }
      }
    },
    "/old-api": {
      "get": {
        "summary": "Old API endpoint",
        "description": "Redirects old API path to new location using 308 status code",
        "operationId": "redirect-old-api",
        "x-opengate": {
          "type": "redirect",
          "options": {
            "location": "/api/users",
            "status_code": 308
          }
        },
        "responses": {
          "308": {
            "description": "Permanent Redirect"
          }
        }
      }
    }
  }
}
